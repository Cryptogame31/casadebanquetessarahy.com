{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/refund-policy", "destination": "/politicas" },
    { "source": "/darse-de-baja-play-store", "destination": "/politicas" },
    { "source": "/darse-de-baja", "destination": "/politicas" },
    { "source": "/politica-de-privacidad-y-otras", "destination": "/politicas" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|gif|svg|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
